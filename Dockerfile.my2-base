FROM llvm-mingw-my1-linux-env:latest

WORKDIR /build
COPY wrappers/*.sh wrappers/*.c wrappers/*.h ./wrappers/
COPY ./my_build-all.sh  ./my_build-llvm.sh ./my_build-lldb-mi.sh ./strip-llvm.sh ./install-wrappers.sh ./build-mingw-w64-tools.sh ./build-mingw-w64.sh \
    ./my_build-compiler-rt.sh ./my_build-libcxx.sh ./my_build-mingw-w64-libraries.sh ./my_build-openmp.sh ./my_build_mimalloc.sh ./


ENV TOOLCHAIN_PREFIX=/opt/llvm-mingw
ENV PATH=$TOOLCHAIN_PREFIX/bin:$ORG_PATH

RUN ./my_build-all.sh /build/Windows --host=x86_64-w64-mingw32
RUN ./my_build-llvm.sh /build/Windows --disable-dylib --host=x86_64-w64-mingw32

ENV TOOLCHAIN_PREFIX=/opt/llvm-linux
ENV PATH=$TOOLCHAIN_PREFIX/bin:$ORG_PATH

RUN ./my_build-all.sh /build/Linux --host=x86_64-linux-gnu --disable-cfguard --build-linux --host-clang=/opt/llvm-mingw/bin/x86_64-linux-gnu-clang
RUN ./my_build-llvm.sh /build/Linux --use-exsting-compiler --disable-dylib --host=x86_64-linux-gnu



