FROM llvm-mingw-my-base:latest


ENV TOOLCHAIN_PREFIX=/opt/llvm-mingw
ENV PATH=$TOOLCHAIN_PREFIX/bin:$ORG_PATH
RUN ./my_build-llvm_pgo_pre.sh build/win_pgo_pre32 --host=x86_64-w64-mingw32 --lto
# ./my_build-llvm_pgo_post.sh build/Windows32_pgod --host=x86_64-w64-mingw32 --lto

ENV TOOLCHAIN_PREFIX=/opt/llvm-linux
ENV PATH=$TOOLCHAIN_PREFIX/bin:$ORG_PATH
RUN ./my_build-llvm_pgo_pre.sh build/lin_pgo_pre32 --host=x86_64-linux-gnu --disable-cfguard --lto
# ./my_build-llvm_pgo_post.sh build/Linux32_pgod  --host=x86_64-linux-gnu --disable-cfguard --lto


